<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayBackdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/overlayCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/overlay_card_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✨ BN-ENG AI Assistant"
                android:textColor="#F8FAFC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProviderBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/overlay_input_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Groq"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnOverlayClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#94A3B8"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Input Box so user sees & can edit/paste text -->
        <EditText
            android:id="@+id/etOverlayInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/overlay_input_bg"
            android:hint="মেসেজ কপি করে 📋 পেস্ট চাপুন বা বাংলিশ লিখুন..."
            android:maxLines="3"
            android:minHeight="44dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="13sp" />

        <!-- Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnOverlayPaste"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/overlay_input_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="📋 পেস্ট করুন"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnOverlayTranslate"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_brand_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✨ অনুবাদ করুন"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Loading View -->
        <LinearLayout
            android:id="@+id/layoutOverlayLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="16dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminateTint="#10B981" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="AI অনুবাদ তৈরি করছে..."
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Error View -->
        <TextView
            android:id="@+id/tvOverlayError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#33EF4444"
            android:padding="10dp"
            android:textColor="#FCA5A5"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Scrollable Results -->
        <ScrollView
            android:id="@+id/scrollOverlayResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOverlayHeaderLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="বাংলা অর্থ:"
                    android:textColor="#34D399"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOverlayMeaning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvOverlayRepliesLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="যেকোনো রিপ্লাই ট্যাপ করলে কপি ও রিপ্লেস হবে:"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnOverlayCasual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/overlay_reply_btn_bg"
                    android:padding="10dp"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnOverlayProfessional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/overlay_reply_btn_bg"
                    android:padding="10dp"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnOverlayPolite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/overlay_reply_btn_bg"
                    android:padding="10dp"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnOverlayConcise"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/overlay_reply_btn_bg"
                    android:padding="10dp"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
